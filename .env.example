# Local development only. Copy this file to .env; never commit real credentials.
POSTGRES_DB=mandala_sample
POSTGRES_USER=mandala
POSTGRES_PASSWORD=mandala_local_only

MANDALA_DB_URL=jdbc:postgresql://localhost:5432/mandala_sample
MANDALA_DB_USERNAME=mandala
MANDALA_DB_PASSWORD=mandala_local_only

DATABASE_URL=jdbc:postgresql://localhost:5432/mandala_sample
DATABASE_USERNAME=mandala
DATABASE_PASSWORD=mandala_local_only

BACKEND_PORT=18080
FRONTEND_PORT=5173
OTEL_EXPORT_ENABLED=true
MANDALA_USE_GLOBAL_OTEL=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
